---
import ContentIndexLayout from '../layouts/ContentIndexLayout.astro';
import { CONTENT_SECTIONS } from '../config';
import { SITE } from '../lib/site';
import { getPublishedPosts } from '../lib/content';
const posts = await getPublishedPosts();
---

<ContentIndexLayout
  entries={posts}
  section={CONTENT_SECTIONS.posts}
  description={`Essays and notes on statistics, artificial intelligence, inference, and expertise by ${SITE.title}.`}
  listLabel="Blog posts"
>
  <Fragment slot="heading">Ideas worth<br />writing down.</Fragment>
  <Fragment slot="intro"
    >Essays and reference notes on statistics, artificial intelligence,
    inference, and the work of building expertise.</Fragment
  >
</ContentIndexLayout>
