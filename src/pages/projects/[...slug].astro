---
import { getEntry } from 'astro:content';
import ContentDetail from '../../components/ContentDetail.astro';
import { getPublishedProjects } from '../../lib/content';
import { CONTENT_SECTIONS } from '../../config';

export async function getStaticPaths() {
  return (await getPublishedProjects()).map((entry) => ({
    params: { slug: entry.id },
    props: { id: entry.id },
  }));
}
const { id } = Astro.props;
const entry = await getEntry(CONTENT_SECTIONS.projects.collection, id);
if (!entry) throw new Error(`Project not found: ${id}`);
---

<ContentDetail entry={entry} section={CONTENT_SECTIONS.projects} />
