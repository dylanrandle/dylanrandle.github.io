---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="page-header shell">
    <p class="eyebrow">404</p>
    <h1>Nothing at this coordinate.</h1>
    <p class="lede">The page may have moved, or the link may be incomplete.</p>
    <a class="button primary" href="/">Return home</a>
  </section>
</BaseLayout>
