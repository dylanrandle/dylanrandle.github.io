---
import ContentIndexLayout from '../layouts/ContentIndexLayout.astro';
import { CONTENT_SECTIONS, UI_LABELS } from '../config';
import { SITE } from '../lib/site';
import { getPublishedProjects } from '../lib/content';
const projects = await getPublishedProjects();
---

<ContentIndexLayout
  entries={projects}
  section={CONTENT_SECTIONS.projects}
  description={`Projects and research in robotics, machine learning, and applied artificial intelligence by ${SITE.title}.`}
  listLabel={UI_LABELS.projectsAndResearch}
>
  <Fragment slot="heading">Projects &<br />research.</Fragment>
  <Fragment slot="intro"
    >Work across robotics, machine learning, computer vision, and applied
    artificial intelligence.</Fragment
  >
</ContentIndexLayout>
