---
import type { ContentRecord } from '../data/content-schema';
import { profileData } from '../data/profile';
import { formatProjectCredits } from '../lib/publications';

interface Props {
  entry: ContentRecord;
}
const { entry } = Astro.props;
const credits = formatProjectCredits(
  entry.data.publications,
  profileData.displayName,
);
const { links, publications } = entry.data;
const statusNotes = publications.flatMap(({ title, status }) =>
  status
    ? [
        publications.length > 1
          ? `${title ?? entry.data.title} — ${status}`
          : status,
      ]
    : [],
);
---

{
  (credits || statusNotes.length > 0 || links.length > 0) && (
    <footer class="content-footer">
      {credits && <p class="content-credits">{credits}</p>}
      {statusNotes.map((note) => (
        <p>{note}.</p>
      ))}
      {links.length > 0 && (
        <blockquote class="content-links">
          <p>
            {links.map((link, index) => (
              <Fragment>
                {index > 0 && ' · '}
                <a href={link.href}>{link.label}</a>
              </Fragment>
            ))}
          </p>
        </blockquote>
      )}
    </footer>
  )
}
