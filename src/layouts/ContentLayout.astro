---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Tags from '../components/Tags.astro';
import type { ContentSection } from '../config';
import type { ContentEntry } from '../lib/content';
import { formatContentDate } from '../lib/dates';
import ContentMedia from '../components/ContentMedia.astro';
import { renderArticleMedia } from '../lib/render-media';
import mathStyles from 'katex/dist/katex.min.css?inline';

interface Props {
  entry: ContentEntry;
  section: ContentSection;
  headings: MarkdownHeading[];
}
const { entry, section, headings } = Astro.props;
const { title, description, date, updated, tags, image, video } = entry.data;
const articleMarkup = await renderArticleMedia(
  await Astro.slots.render('default'),
);
const hasMath = articleMarkup.includes('class="katex');
const eyebrow = entry.data.category ?? section.singularLabel;
---

<BaseLayout
  title={title}
  description={description}
  image={image?.src}
  type="article"
>
  {hasMath && <style is:inline set:html={mathStyles} slot="head" />}
  <header class="page-header shell">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    {
      date && (
        <p class="post-date">
          <time datetime={date.toISOString()}>
            {formatContentDate(date, 'article')}
          </time>
          {updated && ` · Updated ${formatContentDate(updated, 'article')}`}
        </p>
      )
    }
    {tags.length > 0 && <Tags tags={tags} />}
    <slot name="links" />
  </header>
  {image && <ContentMedia image={image} video={video} context="hero" />}
  <div class="article-shell shell">
    <article class="prose">
      <Fragment set:html={articleMarkup} />
    </article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
