---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Tags from '../components/Tags.astro';
import type { ContentSection } from '../config';
import type { ContentEntry } from '../lib/content';
import { formatContentDate } from '../lib/dates';
import { resolveContentMedia } from '../lib/media';

interface Props {
  entry: ContentEntry;
  section: ContentSection;
  headings: MarkdownHeading[];
}
const { entry, section, headings } = Astro.props;
const { title, description, date, updated, tags, image, video } = entry.data;
const { imageWidth, imageHeight } = await resolveContentMedia(entry.data);
const eyebrow = entry.data.category ?? section.singularLabel;
---

<BaseLayout
  title={title}
  description={description}
  image={image?.src}
  type="article"
>
  <header class="page-header shell">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    {
      date && (
        <p class="post-date">
          <time datetime={date.toISOString()}>
            {formatContentDate(date, 'article')}
          </time>
          {updated && ` · Updated ${formatContentDate(updated, 'article')}`}
        </p>
      )
    }
    {tags.length > 0 && <Tags tags={tags} />}
    <slot name="links" />
  </header>
  {
    video ? (
      <video
        class="article-hero"
        muted
        loop
        playsinline
        preload="auto"
        poster={image?.src}
        aria-label={image?.alt}
        data-autoplay-video
      >
        <source src={video} type="video/mp4" />
      </video>
    ) : image ? (
      <img
        class:list={['article-hero', { cover: image.fit === 'cover' }]}
        src={image.src}
        alt={image.alt}
        width={imageWidth}
        height={imageHeight}
      />
    ) : null
  }
  <div class="article-shell shell">
    <article class="prose">
      <slot />
    </article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
