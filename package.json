{
  "name": "dylanrandle-portfolio",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "npm run check:astro && npm run check:resume && npm run check:format && npm run check:e2e && npm run check:links",
    "check:astro": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:resume": "node scripts/generate-resume.mjs --check",
    "check:format": "prettier --check .",
    "check:e2e": "npm run build && playwright test",
    "check:links": "node scripts/check-internal-links.mjs dist",
    "format": "prettier --write .",
    "resume:generate": "node scripts/generate-resume.mjs",
    "setup:e2e": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "latest",
    "@astrojs/sitemap": "latest",
    "astro": "latest",
    "katex": "latest",
    "rehype-katex": "latest",
    "remark-math": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@playwright/test": "latest",
    "prettier": "latest",
    "prettier-plugin-astro": "latest",
    "sharp": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
